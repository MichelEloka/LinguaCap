{
  "openapi": "3.1.0",
  "info": {
    "title": "LinguaCap API publique",
    "version": "1.0.0",
    "description": "Contrat de l'API exposée par la passerelle sous /api/v1. Chaque route déclarée ici doit être routée par la passerelle Quarkus et seules ces routes peuvent être appelées par l'interface React. Les tests des deux côtés lisent ce fichier."
  },
  "servers": [{ "url": "/api/v1" }],
  "security": [{ "supabaseSession": [] }],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "État de la passerelle et des six services",
        "security": [],
        "responses": {
          "200": { "description": "Santé agrégée", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/me": {
      "get": {
        "operationId": "getCurrentProfile",
        "summary": "Profil LinguaCap de la session",
        "responses": {
          "200": { "description": "Profil courant", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CurrentProfile" } } } },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/learners": {
      "get": {
        "operationId": "listLearners",
        "summary": "Élèves visibles par un professeur ou un administrateur",
        "responses": {
          "200": { "description": "Élèves", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Profile" } } } } },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/learners/{learnerId}": {
      "get": {
        "operationId": "getLearner",
        "summary": "Fiche d'un élève accessible",
        "parameters": [{ "$ref": "#/components/parameters/LearnerIdPath" }],
        "responses": {
          "200": { "description": "Élève", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Profile" } } } },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/invitations": {
      "post": {
        "operationId": "createInvitation",
        "summary": "Inviter un professeur ou un élève",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InvitationRequest" } } } },
        "responses": {
          "201": { "description": "Invitation enregistrée", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InvitationReceipt" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/levels": {
      "get": {
        "operationId": "listLevels",
        "summary": "Niveaux du catalogue",
        "responses": {
          "200": { "description": "Niveaux", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Level" } } } } },
          "401": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "operationId": "createLevel",
        "summary": "Créer un niveau en brouillon",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateLevel" } } } },
        "responses": {
          "201": { "description": "Niveau créé", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Level" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/levels/{levelId}/publish": {
      "post": {
        "operationId": "publishLevel",
        "summary": "Publier un niveau",
        "parameters": [{ "$ref": "#/components/parameters/LevelIdPath" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "maxProperties": 0 } } } },
        "responses": {
          "200": { "description": "Niveau publié", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Level" } } } },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/lessons/{lessonId}": {
      "get": {
        "operationId": "getLesson",
        "summary": "Leçon sans corrigé",
        "parameters": [{ "$ref": "#/components/parameters/LessonIdPath" }],
        "responses": {
          "200": { "description": "Leçon", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Lesson" } } } },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/media": {
      "get": {
        "operationId": "listMedia",
        "summary": "Médiathèque (administration)",
        "responses": {
          "200": { "description": "Ressources", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/MediaMetadata" } } } } },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/media/{mediaId}": {
      "get": {
        "operationId": "getMedia",
        "summary": "Média avec un lien de lecture temporaire",
        "parameters": [{ "$ref": "#/components/parameters/MediaIdPath" }],
        "responses": {
          "200": { "description": "Média", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MediaDetail" } } } },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/learning/goal": {
      "get": {
        "operationId": "getGoal",
        "summary": "Objectif de l'élève connecté",
        "responses": {
          "200": { "description": "Objectif, ou null s'il n'existe pas encore", "content": { "application/json": { "schema": { "oneOf": [{ "$ref": "#/components/schemas/Goal" }, { "type": "null" }] } } } },
          "401": { "$ref": "#/components/responses/Error" }
        }
      },
      "put": {
        "operationId": "saveGoal",
        "summary": "Enregistrer l'objectif de l'élève connecté",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GoalRequest" } } } },
        "responses": {
          "200": { "description": "Objectif enregistré", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Goal" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/learning/progress": {
      "get": {
        "operationId": "getProgress",
        "summary": "Progression d'un élève",
        "parameters": [{ "$ref": "#/components/parameters/LearnerIdQuery" }],
        "responses": {
          "200": { "description": "Progression", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Progress" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/assessments/quiz": {
      "post": {
        "operationId": "submitQuiz",
        "summary": "Remettre un quiz (idempotent)",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/QuizRequest" } } } },
        "responses": {
          "200": { "description": "Résultat", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Grade" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/assessments/results": {
      "get": {
        "operationId": "listResults",
        "summary": "Résultats de quiz d'un élève",
        "parameters": [{ "$ref": "#/components/parameters/LearnerIdQuery" }],
        "responses": {
          "200": { "description": "Résultats", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Grade" } } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/tracking/overview": {
      "get": {
        "operationId": "getTrackingOverview",
        "summary": "Vue d'ensemble des élèves suivis",
        "responses": {
          "200": { "description": "Synthèse", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TrackingOverview" } } } },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/tracking/messages": {
      "get": {
        "operationId": "listMessages",
        "summary": "Encouragements reçus ou envoyés",
        "parameters": [{ "$ref": "#/components/parameters/LearnerIdQuery" }],
        "responses": {
          "200": { "description": "Encouragements", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Message" } } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "operationId": "sendMessage",
        "summary": "Envoyer un encouragement",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageRequest" } } } },
        "responses": {
          "200": { "description": "Encouragement envoyé", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Message" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "supabaseSession": { "type": "http", "scheme": "bearer", "description": "Jeton d'accès de la session Supabase Auth." }
    },
    "parameters": {
      "LearnerIdPath": { "name": "learnerId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" }, "example": "7d1f3c5a-2b4e-4f60-8a1b-9c0d2e3f4a5b" },
      "LearnerIdQuery": { "name": "learnerId", "in": "query", "required": false, "description": "Élève consulté par un professeur ou un administrateur. Absent pour l'élève connecté.", "schema": { "$ref": "#/components/schemas/Uuid" }, "example": "7d1f3c5a-2b4e-4f60-8a1b-9c0d2e3f4a5b" },
      "LevelIdPath": { "name": "levelId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Slug" }, "example": "b1" },
      "LessonIdPath": { "name": "lessonId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Slug" }, "example": "commander-au-cafe" },
      "MediaIdPath": { "name": "mediaId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Slug" }, "example": "kaffee-image" },
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": false, "description": "Une même clé et les mêmes réponses renvoient la même remise.", "schema": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" }, "example": "3f6c2a8e-quiz" }
    },
    "responses": {
      "Error": { "description": "Erreur métier ou technique", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    },
    "schemas": {
      "Uuid": { "type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F]{8}-(?:[0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$" },
      "Slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$" },
      "Role": { "type": "string", "enum": ["admin", "teacher", "learner"] },
      "LevelCode": { "type": "string", "pattern": "^[ABC][12]$" },
      "Error": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z_]*$", "description": "Code exploitable, par exemple INVALID_INPUT, UNAUTHENTICATED, FORBIDDEN, NOT_FOUND, CONFLICT ou UNAVAILABLE." },
          "message": { "type": "string", "minLength": 1 }
        }
      },
      "Health": {
        "type": "object",
        "required": ["status"],
        "additionalProperties": false,
        "properties": { "status": { "type": "string", "enum": ["ok", "degraded"] } }
      },
      "CurrentProfile": {
        "type": "object",
        "required": ["id", "displayName", "role"],
        "properties": {
          "id": { "$ref": "#/components/schemas/Uuid" },
          "displayName": { "type": "string" },
          "role": { "$ref": "#/components/schemas/Role" }
        }
      },
      "Profile": {
        "type": "object",
        "required": ["id", "displayName", "role", "teacherId"],
        "properties": {
          "id": { "$ref": "#/components/schemas/Uuid" },
          "displayName": { "type": "string" },
          "role": { "$ref": "#/components/schemas/Role" },
          "teacherId": { "oneOf": [{ "$ref": "#/components/schemas/Uuid" }, { "type": "null" }] }
        }
      },
      "InvitationRequest": {
        "type": "object",
        "required": ["email", "displayName", "role"],
        "properties": {
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 140 },
          "role": { "type": "string", "enum": ["teacher", "learner"] },
          "teacherId": { "oneOf": [{ "$ref": "#/components/schemas/Uuid" }, { "type": "null" }] }
        }
      },
      "InvitationReceipt": {
        "type": "object",
        "required": ["id", "email", "displayName", "role", "teacherId", "status"],
        "properties": {
          "id": { "$ref": "#/components/schemas/Uuid" },
          "email": { "type": "string" },
          "displayName": { "type": "string" },
          "role": { "type": "string", "enum": ["teacher", "learner"] },
          "teacherId": { "oneOf": [{ "$ref": "#/components/schemas/Uuid" }, { "type": "null" }] },
          "status": { "type": "string" }
        }
      },
      "CreateLevel": {
        "type": "object",
        "required": ["code", "title"],
        "properties": {
          "code": { "$ref": "#/components/schemas/LevelCode" },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "maxLength": 2000 }
        }
      },
      "Level": {
        "type": "object",
        "required": ["id", "code", "title", "status", "description", "version"],
        "properties": {
          "id": { "$ref": "#/components/schemas/Slug" },
          "code": { "$ref": "#/components/schemas/LevelCode" },
          "title": { "type": "string" },
          "status": { "type": "string", "enum": ["draft", "published"] },
          "description": { "type": "string" },
          "version": { "type": "integer", "minimum": 1 }
        }
      },
      "Lesson": {
        "type": "object",
        "required": ["id", "title", "level", "description", "transcript", "mediaIds", "questions"],
        "properties": {
          "id": { "$ref": "#/components/schemas/Slug" },
          "title": { "type": "string" },
          "level": { "$ref": "#/components/schemas/LevelCode" },
          "description": { "type": "string" },
          "transcript": { "type": "string" },
          "mediaIds": { "type": "array", "items": { "$ref": "#/components/schemas/Slug" } },
          "questions": { "type": "array", "items": { "$ref": "#/components/schemas/Question" } }
        }
      },
      "Question": {
        "type": "object",
        "required": ["id", "prompt", "options"],
        "properties": {
          "id": { "type": "string" },
          "prompt": { "type": "string" },
          "options": { "type": "array", "items": { "$ref": "#/components/schemas/Option" } }
        }
      },
      "Option": {
        "type": "object",
        "required": ["id", "text"],
        "additionalProperties": false,
        "description": "Le corrigé n'est jamais exposé : aucune propriété correct.",
        "properties": { "id": { "type": "string" }, "text": { "type": "string" } }
      },
      "MediaMetadata": {
        "type": "object",
        "required": ["id", "kind", "title", "mimeType", "status"],
        "properties": {
          "id": { "$ref": "#/components/schemas/Slug" },
          "kind": { "type": "string", "enum": ["image", "audio"] },
          "title": { "type": "string" },
          "mimeType": { "type": "string" },
          "alt": { "type": ["string", "null"] },
          "transcript": { "type": ["string", "null"] },
          "credit": { "type": ["string", "null"] },
          "status": { "type": "string", "enum": ["draft", "published"] }
        }
      },
      "MediaDetail": {
        "type": "object",
        "required": ["id", "kind", "title", "mimeType", "url"],
        "properties": {
          "id": { "$ref": "#/components/schemas/Slug" },
          "kind": { "type": "string", "enum": ["image", "audio"] },
          "title": { "type": "string" },
          "mimeType": { "type": "string" },
          "url": { "type": "string", "format": "uri", "description": "Lien de lecture de courte durée." },
          "alt": { "type": ["string", "null"] },
          "transcript": { "type": ["string", "null"] },
          "credit": { "type": ["string", "null"] }
        }
      },
      "GoalRequest": {
        "type": "object",
        "required": ["level", "pace", "startDate", "targetDate", "studyDays", "sessionsPerDay", "minutesPerSession"],
        "properties": {
          "level": { "$ref": "#/components/schemas/LevelCode" },
          "pace": { "type": "string", "enum": ["standard", "intensive"] },
          "startDate": { "type": "string", "format": "date" },
          "targetDate": { "type": "string", "format": "date" },
          "studyDays": { "type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 7 } },
          "sessionsPerDay": { "type": "integer", "minimum": 1 },
          "minutesPerSession": { "type": "integer", "minimum": 1 }
        }
      },
      "Goal": {
        "allOf": [
          { "$ref": "#/components/schemas/GoalRequest" },
          { "type": "object", "required": ["updatedAt"], "properties": { "updatedAt": { "type": "string", "format": "date-time" } } }
        ]
      },
      "Grade": {
        "type": "object",
        "required": ["id", "lessonId", "correct", "total", "submittedAt"],
        "properties": {
          "id": { "$ref": "#/components/schemas/Uuid" },
          "lessonId": { "$ref": "#/components/schemas/Slug" },
          "correct": { "type": "integer", "minimum": 0 },
          "total": { "type": "integer", "minimum": 1 },
          "submittedAt": { "type": "string", "format": "date-time" }
        }
      },
      "QuizRequest": {
        "type": "object",
        "required": ["lessonId", "answers"],
        "properties": {
          "lessonId": { "$ref": "#/components/schemas/Slug" },
          "answers": { "type": "object", "description": "Identifiant de question vers identifiant d'option.", "additionalProperties": { "type": "string" } }
        }
      },
      "Progress": {
        "type": "object",
        "required": ["learnerId", "completedLessons", "completedCount", "goal", "results"],
        "properties": {
          "learnerId": { "$ref": "#/components/schemas/Uuid" },
          "completedLessons": { "type": "array", "items": { "$ref": "#/components/schemas/Slug" } },
          "completedCount": { "type": "integer", "minimum": 0 },
          "goal": { "oneOf": [{ "$ref": "#/components/schemas/Goal" }, { "type": "null" }] },
          "results": { "type": "array", "items": { "$ref": "#/components/schemas/Grade" } }
        }
      },
      "TrackingOverview": {
        "type": "object",
        "required": ["learners", "learnerCount", "goalsCount", "learnersWithResults"],
        "properties": {
          "learners": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["learnerId", "profile", "progress", "results"],
              "properties": {
                "learnerId": { "$ref": "#/components/schemas/Uuid" },
                "profile": { "$ref": "#/components/schemas/Profile" },
                "progress": { "$ref": "#/components/schemas/Progress" },
                "results": { "type": "array", "items": { "$ref": "#/components/schemas/Grade" } }
              }
            }
          },
          "learnerCount": { "type": "integer", "minimum": 0 },
          "goalsCount": { "type": "integer", "minimum": 0 },
          "learnersWithResults": { "type": "integer", "minimum": 0 }
        }
      },
      "MessageRequest": {
        "type": "object",
        "required": ["learnerId", "text"],
        "properties": {
          "learnerId": { "$ref": "#/components/schemas/Uuid" },
          "text": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      },
      "Message": {
        "type": "object",
        "required": ["id", "learnerId", "authorId", "text", "sentAt"],
        "properties": {
          "id": { "$ref": "#/components/schemas/Uuid" },
          "learnerId": { "$ref": "#/components/schemas/Uuid" },
          "authorId": { "$ref": "#/components/schemas/Uuid" },
          "text": { "type": "string" },
          "sentAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
