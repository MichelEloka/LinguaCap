{
  "name": "linguacap-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "linguacap.emichfer.org",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../../linguacap-react/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  }
}
