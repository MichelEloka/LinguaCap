# Simulateur en mémoire (npm run dev:mock) : interface en mode API, API et Supabase Auth simulés par src/integration/mock-api.ts.
# Chargé par « node --env-file » (le dossier des variables de Vite est la racine du dépôt). Aucune donnée réelle, aucun secret.
# Rôle : ?as=eleve-autonome | eleve-suivi | professeur | professeur-nouveau | admin | equipe ; ?reset repart des données initiales.
VITE_LINGUACAP_MODE=api
VITE_LINGUACAP_MOCK=1
